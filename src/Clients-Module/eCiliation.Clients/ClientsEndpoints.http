# For more info on HTTP files go to https://aka.ms/vs/httpfile
@host=https://localhost
@port=7059

// List all clients
GET {{host}}:{{port}}/clients

###

// Get a specific client
@id_to_get=3910d433-23e6-4b31-aa3e-74965a1c3926
GET {{host}}:{{port}}/clients/{{id_to_get}}
Accept: application/json

###

// Add a new client
POST {{host}}:{{port}}/clients
Content-Type: application/json

{
  "name": "Client E",
  "description": "Client E Description",
  "userId": "kwilliams"
}

###

// Update a client
@id_to_update=b75c093c-6ae4-4ad2-9f15-9f24850f2170
PUT {{host}}:{{port}}/clients/{{id_to_update}}
Content-Type: application/json

{
  "name": "Client B",
  "description": "Client B Description - Updated Again",
  "userId": "kwilliams"
}

###

// Deactivate a client
@id_to_deactivate=b75c093c-6ae4-4ad2-9f15-9f24850f2170
PUT {{host}}:{{port}}/clients/{{id_to_deactivate}}/deactivate
Content-Type: application/json

{
  "id": "b75c093c-6ae4-4ad2-9f15-9f24850f2170",
  "userId": "kwilliams"
}